# Arad CRM-OS web-admin — Next 15 desktop console, served at ops.aradap.ir
# (ADR-013 §2: Arad's internal console for the pilot; the tenant-manager /
# Arad-ops split happens at tenant #2, and the URL does not move).
#
# Same build pattern as Dockerfile.web-seller — see its header.

FROM node:22-alpine AS build
WORKDIR /app

ENV COREPACK_NPM_REGISTRY=https://registry.npmjs.com
ENV npm_config_registry=https://registry.npmjs.com
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY apps/ops/package.json apps/ops/
COPY apps/worker/package.json apps/worker/
COPY apps/web-seller/package.json apps/web-seller/
COPY apps/web-admin/package.json apps/web-admin/
COPY packages packages
COPY foundation foundation

RUN pnpm install --frozen-lockfile

COPY . .

ARG IMAGE_TAG=dev
ENV NEXT_PUBLIC_BUILD_TAG=$IMAGE_TAG
ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL

RUN pnpm --filter @arad-crm/web-admin build

FROM node:22-alpine AS runtime
ARG IMAGE_TAG=dev
ARG BUILD_TIME=unknown
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=80
COPY --from=build /app/apps/web-admin/.next/standalone ./
COPY --from=build /app/apps/web-admin/.next/static ./apps/web-admin/.next/static
COPY --from=build /app/apps/web-admin/public ./apps/web-admin/public
RUN printf 'tag=%s\nbuild_time=%s\n' "$IMAGE_TAG" "$BUILD_TIME" \
      > apps/web-admin/public/version.txt \
 && printf '{"tag":"%s","buildTime":"%s"}\n' "$IMAGE_TAG" "$BUILD_TIME" \
      > apps/web-admin/public/version.json

EXPOSE 80
CMD ["node", "apps/web-admin/server.js"]
