# Arad CRM-OS — production env template for the `arad-crm` mvpool slug.
# ADR-013. Copy into /srv/apps/arad-crm/.env on the pool (mode 600) and fill
# every REQUIRED value. This file is an example only — 🔒 never commit real
# secrets (deploy/scripts/secret-grep.sh fails the build if you do).
#
# mvpool writes DATABASE_URL / REDIS_URL itself at `mvp:add` time; the rest is
# ours. IMAGE_TAG and REGISTRY are rewritten by the deploy script per release.

NODE_ENV=production
LOG_LEVEL=info

# ── Provisioned by mvpool at `mvp:add` (do not hand-edit) ───────────────────
# 🔒 Own database + own Redis DB index — never Mizro's (ADR-002).
# DATABASE_URL=postgres://arad_crm:<pw>@postgres:5432/arad_crm
# REDIS_URL=redis://redis:6379/<index>

# api listen port — must match Dockerfile.api EXPOSE + compose healthcheck +
# the Caddy reverse_proxy target (api:4100).
API_PORT=4100

# ── REQUIRED — session ──────────────────────────────────────────────────────
# min 32 chars. Generate: openssl rand -base64 32
JWT_SECRET=
SESSION_TTL_SECONDS=2592000

# 🔒 ADR-013 §3 — leading dot: one login covers every *.aradap.ir surface.
# Must be set in production, and setSessionCookie/clearSessionCookie both use
# it (they must agree, or logout cannot delete the cookie).
COOKIE_DOMAIN=.aradap.ir

# ── REQUIRED — CORS (credentialed; '*' is illegal here) ─────────────────────
# Every browser origin that calls the api with cookies. The Mizro producer
# sends no Origin header, so webhooks are unaffected by this list.
WEB_ORIGINS=https://mizro-crm.aradap.ir,https://ops.aradap.ir

# ── REQUIRED — Mizro integration (ADR-006) ─────────────────────────────────
# HMAC shared secret. Unset ⇒ /v1/integrations/events refuses with 503, which
# is the correct failure mode: never accept unsigned money events.
# Generate: openssl rand -hex 24 — then set the SAME value on the Mizro side
# and only then flip Mizro's CRM_EVENTS_ENABLED. Its outbox holds a backlog
# safely until you do (verified over a 3-day gap, 2026-07-26).
MIZRO_WEBHOOK_SECRET=

# Seller demo links: <DEMO_LINK_BASE>?ref=<attribution token> 🔒 the
# attribution linchpin — Mizro must persist `ref` onto the business it creates.
DEMO_LINK_BASE=https://mizro.ir/demo

# ── OTP / SMS ───────────────────────────────────────────────────────────────
# ⚠️ 'fake' logs OTP codes to stdout — the only provider wired today
# (real providers arrive with foundation wave-2, @arad/connect). Sellers cannot
# receive a real SMS until then; seed pilot users and verify the login path
# before the pilot depends on it.
SMS_PROVIDER=fake
OTP_TTL_SECONDS=180
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# ⚠️ Per-IP hourly OTP cap. Behind the Arvan edge, every seller resolves to the
# same edge IP until Caddy's trusted_proxies lists Arvan's ranges (ADR-013 §5) —
# so this is a TEAM-WIDE bucket, not per-user. Leave it high until
# trusted_proxies is configured, then drop it back to 30. The per-mobile cap
# (5/hour, not configurable) is what actually protects each user.
OTP_MAX_REQUESTS_PER_IP_HOUR=300

# ── Written per release by the deploy script ────────────────────────────────
# REGISTRY=registry.<pool-domain>
# IMAGE_TAG=<git short sha>
