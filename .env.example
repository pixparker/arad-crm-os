# Arad CRM-OS — dev environment. Copy to .env and adjust.
#
# The apps live in one contiguous block, 6100–6103, nowhere near Mizro's dev
# stack (api 4000, web 3001-3006) so both products run side by side and a
# stray listener is never mistaken for the other product's:
#   6100 api · 6101 web-seller · 6102 web-admin · 6103 ops
# Datastores are the SHARED portfolio dev stack (foundation/delivery/dev,
# ADR-P007): one Postgres on 5432 and one Redis on 6379 for every product.
# Isolation is per-database and per-Redis-index, not per-container.

NODE_ENV=development
LOG_LEVEL=info

# Own database — 🔒 never Mizro's (ADR-002). Own role too; the shared server
# only ever hands out `arad_crm` to the `arad` role.
DATABASE_URL=postgres://arad:arad@localhost:5432/arad_crm

# Own Redis INDEX (1) on the shared server — 🔒 the index is the isolation
# boundary, so it is never omitted. Mizro is 0, faraward 2, neksta 3.
REDIS_URL=redis://localhost:6379/1

# api (Hono) listen port. Change it and the web apps need
# NEXT_PUBLIC_API_BASE_URL to match — they default to http://localhost:6100.
API_PORT=6100

# Session JWT signing secret — min 32 chars. Generate: openssl rand -base64 32
JWT_SECRET=

# Session TTL (seconds). Sliding refresh resets it per request (ADR-005).
SESSION_TTL_SECONDS=2592000

# OTP knobs (defaults mirror @arad/auth-otp expectations).
OTP_TTL_SECONDS=180
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
# Per-IP hourly OTP cap. Becomes a shared bucket behind a CDN edge whose ranges
# aren't in Caddy's trusted_proxies — see ADR-013 §5 before lowering in prod.
OTP_MAX_REQUESTS_PER_IP_HOUR=30

# 🔒 Pinned login code for QA — every OTP is this, so nobody has to tail a log
# to sign in. Applies only with SMS_PROVIDER=fake outside production, and the
# api REFUSES TO BOOT if it is non-empty when NODE_ENV=production. Leave it
# empty for random codes in dev too.
DEV_OTP_CODE=1234

# 'fake' logs codes to stdout in dev. 'connect' routes through @arad/connect:
# the provider, its credentials and its OTP template live in the `connections`
# store and are managed from the ops panel — never here (ADR-014 §3).
SMS_PROVIDER=fake

# 🔒 Connect's master key (KEK) — required when SMS_PROVIDER=connect. Base64 of
# exactly 32 random bytes: openssl rand -base64 32
# It seals every per-connection key, so LOSING IT MEANS LOSING EVERY STORED
# CREDENTIAL. Back it up outside the host.
CONNECT_MASTER_KEY=

# ADR-006: HMAC shared secret with the Mizro producer (min 16 chars).
# Unset = the /v1/integrations/events endpoint refuses (503).
# Generate: openssl rand -hex 24
MIZRO_WEBHOOK_SECRET=

# Seller demo links: <base>?ref=<attribution token>
DEMO_LINK_BASE=https://mizro.ir/demo

# Browser origins allowed to call the api with cookies (CORS). Comma-separated.
# Default covers the two dev web apps; set real hosts in lab/prod.
WEB_ORIGINS=http://localhost:6101,http://localhost:6102,http://localhost:6103
