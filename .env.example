# Arad CRM-OS — dev environment. Copy to .env and adjust.
# Ports are deliberately offset from Mizro's dev stack (api 4000, web 3001-3006,
# pg 5432, redis 6379) so both products run side by side.

NODE_ENV=development
LOG_LEVEL=info

# Own database — 🔒 never Mizro's (ADR-002). Dev compose maps host port 5433.
DATABASE_URL=postgres://arad:arad@localhost:5433/arad_crm

# Own Redis — dev compose maps host port 6380.
REDIS_URL=redis://localhost:6380

# api (Hono) listen port.
API_PORT=4100

# Session JWT signing secret — min 32 chars. Generate: openssl rand -base64 32
JWT_SECRET=

# Session TTL (seconds). Sliding refresh resets it per request (ADR-005).
SESSION_TTL_SECONDS=2592000

# OTP knobs (defaults mirror @arad/auth-otp expectations).
OTP_TTL_SECONDS=180
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# 'fake' logs codes to stdout in dev. Real providers arrive with foundation
# wave-2 (@arad/connect).
SMS_PROVIDER=fake
